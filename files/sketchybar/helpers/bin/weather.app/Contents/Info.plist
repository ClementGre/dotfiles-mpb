<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Info.plist of bin/weather.app. A bundle, opened with `open`, because macOS never shows the
     location prompt for a bare binary launched by sketchybar. LSUIElement: no Dock icon -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>io.clgr.sketchybar.weather</string>
  <key>CFBundleName</key>
  <string>sketchybar weather</string>
  <key>CFBundleExecutable</key>
  <string>weather</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSLocationUsageDescription</key>
  <string>Shows the weather where you are in sketchybar.</string>
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>Shows the weather where you are in sketchybar.</string>
</dict>
</plist>
