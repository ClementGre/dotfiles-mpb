<!-- Embedded in bin/calendar so macOS can ask for calendar access -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>io.clgr.sketchybar.calendar</string>
  <key>CFBundleName</key>
  <string>sketchybar calendar</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Shows your current and upcoming events in sketchybar.</string>
  <key>NSCalendarsUsageDescription</key>
  <string>Shows your current and upcoming events in sketchybar.</string>
</dict>
</plist>
